rules_version = '2';
// Chaque personne ne peut lire/écrire que ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /items/{itemId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // Photo compressée incluse : on plafonne la taille d'une pièce (~900 Ko).
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.id == itemId
          && (!('photo' in request.resource.data) || request.resource.data.photo.size() < 900000);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
