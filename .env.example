# Clé API Gemini (https://aistudio.google.com/apikey) — à définir dans Vercel > Settings > Environment Variables
GEMINI_API_KEY=
# Optionnel : modèle Gemini (par défaut l'alias "gemini-flash-latest", toujours à jour)
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Firebase (comptes + base de données). Firebase console > Paramètres du projet > Vos applications > Web.
# Si ces variables sont vides, l'app fonctionne sans compte (données locales au navigateur).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
