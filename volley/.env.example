# Firebase (comptes + base partagée). Firebase console > Paramètres du projet > Vos applications > Web.
# Si ces variables sont vides, l'app tourne en mode démo local (données dans le navigateur uniquement).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
